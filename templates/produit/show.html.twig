{% extends 'base.html.twig' %}

{% block title %}Détails du produit{% endblock %}

{% block body %}
    <h1>Détails du produit</h1>
   
    <p><strong>Référence :</strong> {{ produit.reference }}</p>
    <p><strong>Libellé :</strong> {{ produit.libelle }}</p>
    <p><strong>Description :</strong> {{ produit.description }}</p>
    <p><strong>Date :</strong> {{ produit.date ? produit.date|date('Y-m-d') : '' }}</p>
    <p><strong>Prix :</strong> {{ produit.prix }} €</p>
    <p><strong>Stock :</strong> {{ produit.stock }}</p>

    <a href="{{ path('app_produit') }}">Retour à la liste</a>
{% endblock %}